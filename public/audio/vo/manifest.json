  "narrator-9002b015": {"voice":"narrator","text":"Little does the founder know, the database is already gone.","file":"narrator-9002b015.mp3","dur":4.0,"env":"7dfcbedade93c94bfedcaccbb985432100000002a85acb7847a9656969a98686744aaa8653321000","words":[[0.0,0.4],[0.4,0.56],[0.56,0.8],[0.8,1.36],[1.36,1.92],[1.92,2.08],[2.08,2.72],[2.72,2.96],[2.96,3.36],[3.36,3.76]],"wer":0.0},
  "narrator-d4c1efb1": {"voice":"narrator","text":"The senior developer sighs. It is the sound of a thousand merged pull requests.","file":"narrator-d4c1efb1.mp3","dur":5.95,"env":"0475666dfdcba85a6bdab58a75599aa987445430000000000000001bdbb6369549cccbba8892119bb958aaabcbb743123ab96662278653312432000","words":[[0.0,0.24],[0.24,0.72],[0.72,1.36],[1.36,2.64],[2.64,2.8],[2.8,3.04],[3.04,3.2],[3.2,3.52],[3.52,3.68],[3.68,3.84],[3.84,4.24],[4.24,4.8],[4.8,5.12],[5.12,5.68]],"wer":0.0},
  "pedant-25287381": {"voice":"pedant","text":"Well, actually, it's pronounced J-I-F.","file":"pedant-25287381.mp3","dur":3.58,"env":"248effc7543346aa544766656212768775221100001123698866459a9732676400000000","words":[[0.24,0.72],[0.72,1.04],[1.12,1.36],[1.36,2.0],[2.24,3.52]],"wer":0.0},
  "pedant-2db20af0": {"voice":"pedant","text":"Well, actually, that's not vibe coding. That's just coding with extra steps.","file":"pedant-2db20af0.mp3","dur":5.12,"env":"5afeeeb71111139bb846668897589433357751228baa841357644332127a6335843249cc9878b61107923266326a9313332100","words":[[0.0,0.72],[0.72,1.28],[1.28,1.68],[1.68,1.92],[1.92,2.32],[2.32,2.88],[2.88,3.12],[3.12,3.36],[3.36,3.84],[3.84,4.0],[4.0,4.48],[4.48,5.12]],"wer":0.0},
  "pedant-c2db6daa": {"voice":"pedant","text":"I'm sorry, but that's technically a race condition, not a feature.","file":"pedant-c2db6daa.mp3","dur":4.16,"env":"bcba7444cda877744927b9132114a60462689c97fe8443988d6589951111110007cca41137724563100","words":[[0.0,0.4],[0.4,0.8],[0.8,0.96],[0.96,1.28],[1.28,1.76],[1.76,1.92],[1.92,2.32],[2.32,3.2],[3.2,3.36],[3.36,3.52],[3.52,4.16]],"wer":0.0},
